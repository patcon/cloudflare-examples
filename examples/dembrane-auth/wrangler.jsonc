{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dembrane-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",

  // Static pages in ./public. Only /api/* runs the Worker first; everything
  // else is served straight from the assets (and falls through to the Worker
  // if no file matches, e.g. `/`).
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },

  // One UserCounter Durable Object per dembrane user, addressed by user id.
  "durable_objects": {
    "bindings": [{ "name": "USER_COUNTER", "class_name": "UserCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserCounter"] }],

  "vars": {
    // Enables POST /api/dev/mint (mock users). Must be "false" anywhere real.
    "DEMO_MODE": "true",
    // Default Directus URL for the "log in with real Directus" option.
    "DIRECTUS_URL": "http://localhost:8055"
  }
  // Secret (not here): DIRECTUS_SECRET — .dev.vars locally, `wrangler secret put` when deployed.
}
