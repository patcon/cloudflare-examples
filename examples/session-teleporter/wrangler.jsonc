{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "session-teleporter",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",

  // Each example has its own port, so they can run side by side.
  "dev": { "port": 8792 },

  // Bundles client/ (PartySocket and the QR code library) into public/dist,
  // before `wrangler dev` and `wrangler deploy`, and again when client/ changes.
  "build": { "command": "pnpm build", "watch_dir": "client" },

  // The page and its bundle. /teleporter/* never matches a file, so it
  // reaches the Worker.
  "assets": { "directory": "./public" },

  // One Teleporter Durable Object per PIN: it relays messages between the
  // sockets connected to that PIN.
  "durable_objects": {
    "bindings": [{ "name": "TELEPORTER", "class_name": "Teleporter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Teleporter"] }]
}
