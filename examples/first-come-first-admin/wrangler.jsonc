{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "first-come-first-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",

  // Each example has its own port, so they can run side by side.
  "dev": { "port": 8791 },

  // No static assets: the pages are bundled into the Worker as text (see
  // src/pages), so the Worker decides who gets the admin page.
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.css"], "fallthrough": true }],

  // One Room Durable Object per URL id: its title, its users and their counters.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
