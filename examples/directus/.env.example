# Local-only Directus. Mirrors echo/.devcontainer/docker-compose.yml, but on SQLite.
HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://localhost:8055
TELEMETRY=false

DB_CLIENT=sqlite3
DB_FILENAME=./data/database.sqlite

# Signs the JWTs. Same value as examples/dembrane-auth/.dev.vars (DIRECTUS_SECRET),
# so tokens from this Directus pass that Worker's check with no extra setup.
SECRET=dev-secret-change-me

ADMIN_EMAIL=admin@dembrane.com
ADMIN_PASSWORD=admin
ADMIN_TOKEN=admin

# Short enough to watch refreshes happen in the other examples.
ACCESS_TOKEN_TTL=15m

CORS_ENABLED=true
CORS_ORIGIN=http://localhost:8787,http://localhost:5173,http://localhost:5174
CORS_CREDENTIALS=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

WEBSOCKETS_ENABLED=true
STORAGE_LOCATIONS=local
STORAGE_LOCAL_ROOT=./uploads
EMAIL_TRANSPORT=sendmail
EMAIL_TEMPLATES_PATH=./templates
EXTENSIONS_AUTO_RELOAD=false

# Your dembrane-echo checkout's echo/ folder, relative to this one or absolute.
# The schema comes from its directus/sync, directus/migrations and directus/templates.
ECHO_DIR=../../../../dembrane-echo/echo
