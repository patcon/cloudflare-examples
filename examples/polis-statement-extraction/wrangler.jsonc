{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polis-statement-extraction",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "ProjectAgent", "name": "ProjectAgent" },
      { "class_name": "SessionAgent", "name": "SessionAgent" }
    ]
  },
  "main": "src/server.ts",
  // Each session's compressed recording, for diarizing once it stops.
  // `vite dev` keeps it on disk, under .wrangler/state.
  "r2_buckets": [
    { "binding": "RECORDINGS", "bucket_name": "polis-statement-extraction-recordings" }
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["ProjectAgent", "SessionAgent"],
      "tag": "v1"
    }
  ]
}
