# Which model to use when the page doesn't pick one: nova-3 or
# gemini-3.5-transcribe-live-preview.
STT_MODEL=nova-3

# For the Gemini model: a Google Cloud project with Vertex AI enabled, and an
# OAuth token for it. `pnpm google-token` fills in the token. It lasts about an hour.
GOOGLE_CLOUD_PROJECT=patcon-local-cli
GOOGLE_ACCESS_TOKEN=
