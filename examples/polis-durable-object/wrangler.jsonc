{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polis-durable-object",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-23",

  // The React app is built into ./dist/client. Only /api/* runs the Worker
  // first; any other path that isn't a file gets index.html, and the app
  // picks a page from the pathname.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
